[user]
    name = shuaikai
    email = wddjwk@qq.com

[init]
    defaultBranch = main

[core]
    editor = nvim
    autocrlt = input
    pager = delta
	autocrlf = input
	symlinks = true

[pull]
	rebase = true

; [merge]
;     conflictstyle = zdiff3

[diff]
	tool = vimdiff

[interactive]
    diffFilter = delta --color-only

[credential]
	helper = store

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true
    side-by-side = true
    line-numbers = false

[alias]
	; s     - 简洁状态显示（short status）
	; his   - 查看文件完整提交历史并显示每次变更内容（follow 追踪重命名）
	; lg    - 图形化提交历史（带分支合并图谱、彩色标注）
	; lng   - 列表式提交历史（无图形，彩色标注）
	; ck    - 智能切换分支：本地存在则 checkout，不存在则从 origin/<branch> 创建并切换
	; ckp   - 先 pull 最新代码，再智能切换分支（同 ck，但 pull 在前）
	; pk    - 批量 cherry-pick：选取 <start> 到 <end>（含两端）之间的所有提交
	; ps    - 智能推送：自动为首次推送的分支设置 upstream，已有 upstream 则直接 push
	; pf    - 强制推送：将当前本地分支强制推送到指定的远程分支（git push -f origin HEAD:<remote-branch>）
	; pl    - 安全拉取：自动 stash 本地未提交改动 -> pull -> 恢复改动，冲突时保留 stash
	; wtadd - 创建 worktree：在 ../trees/<function>/ 下创建独立的 git 工作树用于并行开发
	; wtrm  - 移除 worktree：删除 ../trees/<function>/ 下的工作树并清理关联分支（-f 强制删除）
	s = status -s
	his = log --follow -p
    lg=log --color --graph --pretty=format:'%Cred%h%Creset-%C(yellow)%d%Creset%s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lng=log --color --pretty=format:'%Cred%h%Creset-%C(yellow)%d%Creset%s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	ck = "!f() { test \"$#\" -eq 1 || { echo \"usage: git ck <branch>\" >&2; exit 1; }; if git show-ref --verify --quiet \"refs/heads/$1\"; then git checkout \"$1\"; else git checkout -b \"$1\" \"origin/$1\"; fi; }; f"
    ckp = "!f() { git pull && if git show-ref --verify --quiet refs/heads/\"$1\"; then git checkout \"$1\"; else git checkout -b \"$1\" origin/\"$1\"; fi; }; f"
	pk = "!f() { test \"$#\" -eq 2 || { echo \"usage: git pk <start> <end>\" >&2; exit 1; }; git cherry-pick \"$1^..$2\"; }; f"
	ps = "!f() { test \"$#\" -eq 0 || { echo \"git ps - 智能推送：自动为首次推送的分支设置 upstream\" >&2; echo \"Usage: git ps (不接受任何参数)\" >&2; exit 1; }; branch=$(git symbolic-ref --quiet --short HEAD) || exit 1; if git config --get \"branch.$branch.remote\" >/dev/null; then git push; else git push -u origin \"$branch\"; fi; }; f"
	pf = "!f() { test \"$#\" -eq 1 || { echo \"git pf - 强制推送当前分支到指定远程分支\" >&2; echo \"Usage: git pf <remote-branch>\" >&2; exit 1; }; branch=$(git symbolic-ref --quiet --short HEAD) || exit 1; git push -f origin \"$branch:$1\"; }; f"
	pl = "!f() { local stashed=0; if [ -n \"$(git status --porcelain 2>/dev/null)\" ]; then echo '[git pl] dirty - stashing all changes'; git stash push -u -m 'git pl auto-stash' && stashed=1 || { echo '[git pl] stash failed' >&2; return 1; }; else echo '[git pl] clean - nothing to stash'; fi; if ! git pull \"$@\"; then echo '[git pl] pull failed' >&2; return 1; fi; if [ \"$stashed\" -eq 1 ]; then echo '[git pl] applying stash...'; if git stash apply; then if [ -z \"$(git diff --name-only --diff-filter=U)\" ]; then git stash drop stash@{0}; echo '[git pl] stash applied and dropped'; else echo '[git pl] conflicts re-applying stash. Stash preserved; resolve conflicts then drop manually.' >&2; git diff --name-only --diff-filter=U | sed 's/^/  conflict: /' >&2; return 1; fi; else if [ -n \"$(git diff --name-only --diff-filter=U)\" ]; then echo '[git pl] conflicts re-applying stash. Stash preserved.' >&2; git diff --name-only --diff-filter=U | sed 's/^/  conflict: /' >&2; else echo '[git pl] stash apply failed. Stash preserved.' >&2; fi; return 1; fi; fi; }; f"
	wtadd = "!f() { \\\n    local func=\"$1\"; \\\n    [ -z \"$func\" ] && { echo \"git wtadd - 创建 worktree：在 ../trees/<function>/ 下创建独立的 git 工作树用于并行开发\" >&2; echo \"Usage: git wtadd <function> [-b <new-branch>] [source-branch]\" >&2; exit 1; }; \\\n    shift; \\\n    \\\n    local repo_name=\"$(basename \"$(git rev-parse --show-toplevel)\")\"; \\\n    local current_branch=\"$(git branch --show-current)\"; \\\n    local new_branch=\"\"; \\\n    local source_branch=\"\"; \\\n    \\\n    while [ $# -gt 0 ]; do \\\n        case \"$1\" in \\\n            -b) [ -z \"$2\" ] && { echo \"Error: -b requires a branch name\" >&2; exit 1; }; \\\n                new_branch=\"$2\"; shift 2 ;; \\\n            *) source_branch=\"$1\"; shift ;; \\\n        esac \\\n    done; \\\n    \\\n    source_branch=\"${source_branch:-$current_branch}\"; \\\n    \\\n    if [ -z \"$new_branch\" ]; then \\\n        new_branch=\"${source_branch}_wtree_${func}\"; \\\n    else \\\n        case \"$new_branch\" in \\\n            *\"_wtree_${func}\") ;; \\\n            *) new_branch=\"${new_branch}_wtree_${func}\" ;; \\\n        esac \\\n    fi; \\\n    \\\n    local target_path=\"../trees/${func}/${repo_name}\"; \\\n    echo \"------------------------------------------------\"; \\\n    echo \"Target Path : $target_path\"; \\\n    echo \"Source      : $source_branch\"; \\\n    echo \"New Branch  : $new_branch\"; \\\n    echo \"------------------------------------------------\"; \\\n    \\\n    git worktree add \"$target_path\" -b \"$new_branch\" \"$source_branch\"; \\\n}; f"
	wtrm = "!f() { \\\n    local force=0; \\\n    local func=\"\"; \\\n    while [ $# -gt 0 ]; do \\\n        case \"$1\" in \\\n            -f) force=1; shift ;; \\\n            *) func=\"$1\"; shift ;; \\\n        esac \\\n    done; \\\n    [ -z \"$func\" ] && { echo \"git wtrm - 移除 worktree：删除 ../trees/<function>/ 下的工作树并清理关联分支\" >&2; echo \"Usage: git wtrm [-f] <function>\" >&2; exit 1; }; \\\n    \\\n    local repo_name=\"$(basename \"$(git rev-parse --show-toplevel)\")\"; \\\n    local target_path=\"../trees/${func}/${repo_name}\"; \\\n    local abs_target=\"$(cd \"$(git rev-parse --show-toplevel)/..\" && cd \"trees/${func}/${repo_name}\" 2>/dev/null && pwd)\"; \\\n    \\\n    echo \"------------------------------------------------\"; \\\n    echo \"Removing worktree : $target_path\"; \\\n    [ \"$force\" -eq 1 ] && echo \"Mode            : FORCE\"; \\\n    echo \"------------------------------------------------\"; \\\n    \\\n    if [ \"$force\" -ne 1 ]; then \\\n        local unmerged_found=0; \\\n        git branch --list \"*_wtree_${func}\" | while read -r branch; do \\\n            branch=\"$(echo \"$branch\" | sed 's/^[+* ]*//')\"; \\\n            [ -z \"$branch\" ] && continue; \\\n            local base_branch=\"${branch%_wtree_*}\"; \\\n            local unmerged=\"$(git log --oneline \"${base_branch}..${branch}\" 2>/dev/null)\"; \\\n            if [ -n \"$unmerged\" ]; then \\\n                echo \"Error: branch '$branch' has unmerged commits (not in '$base_branch'):\" >&2; \\\n                echo \"$unmerged\" | sed 's/^/  /' >&2; \\\n                echo \"Use 'git wtrm -f ${func}' to force remove.\" >&2; \\\n                exit 1; \\\n            fi; \\\n        done || exit 1; \\\n    fi; \\\n    \\\n    if git worktree list --porcelain | grep -q \"worktree ${abs_target}\"; then \\\n        if [ \"$force\" -eq 1 ]; then \\\n            git worktree remove --force \"$target_path\" && \\\n                echo \"Worktree force removed.\"; \\\n        else \\\n            if ! git worktree remove \"$target_path\" 2>&1; then \\\n                echo \"Error: Worktree has modifications. Use 'git wtrm -f ${func}' to force remove.\" >&2; \\\n                exit 1; \\\n            fi; \\\n            echo \"Worktree removed.\"; \\\n        fi; \\\n    else \\\n        echo \"Warning: worktree not found, skipping worktree remove.\" >&2; \\\n    fi; \\\n    \\\n    echo \"Cleaning up branches with suffix _wtree_${func}...\"; \\\n    git branch --list \"*_wtree_${func}\" | while read -r branch; do \\\n        branch=\"$(echo \"$branch\" | sed 's/^[+* ]*//')\"; \\\n        [ -z \"$branch\" ] && continue; \\\n        echo \"  Deleting branch: $branch\"; \\\n        git branch -D \"$branch\"; \\\n    done; \\\n    \\\n    local trees_func_dir=\"$(cd \"$(git rev-parse --show-toplevel)/..\" && pwd)/trees/${func}\"; \\\n    if [ -d \"$trees_func_dir\" ]; then \\\n        if [ \"$force\" -eq 1 ]; then \\\n            rm -rf \"$trees_func_dir\" && \\\n                echo \"Force removed directory: trees/${func}\"; \\\n        elif [ -z \"$(ls -A \"$trees_func_dir\" 2>/dev/null)\" ]; then \\\n            rmdir \"$trees_func_dir\" && \\\n                echo \"Removed empty directory: trees/${func}\"; \\\n        else \\\n            echo \"Directory trees/${func} is not empty, keeping it.\"; \\\n        fi; \\\n    fi; \\\n    \\\n    echo \"Done.\"; \\\n}; f"
