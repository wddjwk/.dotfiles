{
    "win": {
        "bash": {
            "repo": "win/bash/.bashrc",
            "local": "${bash_home}/.bashrc"
        },
        "bash_alias": {
            "repo": "win/bash/.bash_aliases",
            "local": "${bash_home}/.bash_aliases"
        },
        "editorconfig": {
            "repo": ".editorconfig",
            "local": "${bash_home}/.editorconfig"
        },
        "pwsh": {
            "repo": "win/pwsh/Microsoft.PowerShell_profile.ps1",
            "local": "~/Documents/PowerShell/Microsoft.PowerShell_profile.ps1"
        },
        "vim": {
            "repo": "vim/vim8/.vimrc",
            "local": "${bash_home}/.vimrc"
        },
        "vim_autoload": {
            "repo": "vim/vim8/.vim/autoload",
            "local": "${bash_home}/.vim/autoload"
        },
        "vim_plugin": {
            "repo": "vim/vim8/.vim/plugin",
            "local": "${bash_home}/.vim/plugin"
        },
        "vim_coc_settings": {
            "repo": "vim/coc-settings.json",
            "local": "${bash_home}/.vim/coc-settings.json"
        },
        "tmux": {
            "repo": ".config/tmux/.tmux.conf",
            "local": "${bash_home}/.config/tmux/tmux.conf"
        },
        "tmux_local": {
            "repo": ".config/tmux/.tmux.conf.local",
            "local": "${bash_home}/.config/tmux/tmux.conf.local"
        },
        "git": {
            "repo": "win/git/.gitconfig",
            "local": "~/.gitconfig"
        },
        "lazygit": {
            "repo": ".config/lazygit/config.yml",
            "local": "${LOCALAPPDATA}/lazygit/config.yml"
        },
        "nvim": {
            "repo": ".config/nvim",
            "local": "${LOCALAPPDATA}/nvim"
        },
        "clangd": {
            "repo": ".config/clangd/config.yaml",
            "local": "${LOCALAPPDATA}/clangd/config.yaml"
        },
        "helix": {
            "repo": "helix/config.toml",
            "local": "${APPDATA}/helix/config.toml"
        },
        "vscode_setting": {
            "repo": "vscode/settings.json",
            "local": "${APPDATA}/Code/User/settings.json"
        },
        "vscode_key": {
            "repo": "vscode/keybindings.json",
            "local": "${APPDATA}/Code/User/keybindings.json"
        },
        "vscode_snippets": {
            "repo": "vscode/snippets",
            "local": "${APPDATA}/Code/User/snippets"
        },
        "wezterm": {
            "repo": ".config/wezterm",
            "local": "~/.config/wezterm"
        },
        "yazi": {
            "repo": ".config/yazi",
            "local": "${APPDATA}/yazi/config"
        }
    },
    "linux": {
        "bash_alias": {
            "repo": "unix/bash/.bash_aliases",
            "local": "~/.bash_aliases"
        },
        "editorconfig": {
            "repo": ".editorconfig",
            "local": "~/.editorconfig"
        },
        "vim": {
            "repo": "vim/vim8/.vimrc",
            "local": "~/.vimrc"
        },
        "vim_autoload": {
            "repo": "vim/vim8/.vim/autoload",
            "local": "~/.vim/autoload"
        },
        "vim_plugin": {
            "repo": "vim/vim8/.vim/plugin",
            "local": "~/.vim/plugin"
        },
        "vim_coc_settings": {
            "repo": "vim/coc-settings.json",
            "local": "~/.vim/coc-settings.json"
        },
        "nvim": {
            "repo": ".config/nvim",
            "local": "~/.config/nvim"
        },
        "git": {
            "repo": "unix/git/.gitconfig",
            "local": "~/.gitconfig"
        },
        "lazygit": {
            "repo": ".config/lazygit/config.yml",
            "local": "~/.config/lazygit/config.yml"
        },
        "helix": {
            "repo": "helix/config.toml",
            "local": ""
        },
        "cgdb": {
            "repo": ".cgdb/cgdbrc",
            "local": "~/.cgdb/cgdbrc"
        },
        "gdb": {
            "repo": "gdb/.gdbinit",
            "local": "~/.gdbinit"
        },
        "pip": {
            "repo": ".pip/pip.conf",
            "local": "~/.pip/pip.conf"
        },
        "redis": {
            "repo": ".redis/redis.conf",
            "local": "~/.redis/redis.conf"
        },
        "clangd": {
            "repo": ".config/clangd/config.yaml",
