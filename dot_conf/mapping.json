        },
        "tmux": {
            "repo": ".config/tmux/.tmux.conf",
            "local": "~/.config/tmux/tmux.conf"
        },
        "tmux_local": {
            "repo": ".config/tmux/.tmux.conf.local",
            "local": "~/.config/tmux/tmux.conf.local"
        },
        "wezterm": {
            "repo": ".config/wezterm",
            "local": "~/.config/wezterm"
        },
        "yazi": {
            "repo": ".config/yazi",
            "local": "~/.config/yazi"
        },
        "zsh": {
            "repo": "unix/zsh/.zshrc",
            "local": "~/.zshrc"
        },
        "claude_settings": {
            "repo": "ai/config/claude-settings.json",
